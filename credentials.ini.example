# WoT Grinder Bot - Credentials Configuration
# ===========================================
# 
# IMPORTANT: Keep this file secure! Do not commit to version control.
# Add 'credentials.ini' to your .gitignore file.
#
# Usage:
#   1. Replace the values below with your actual World of Tanks credentials
#   2. Run the bot: python src/bw_bot.py
#   3. Or set environment variables: WOT_USERNAME and WOT_PASSWORD
#
# Security Notes:
#   - This file should have restricted permissions (chmod 600 on Linux/Mac)
#   - Consider using environment variables in production
#   - Never share this file publicly

[username] = YOUR_WOT_USERNAME_HERE
[password] = YOUR_WOT_PASSWORD_HERE

# Example:
# [username] = player@example.com
# [password] = MySecurePassword123
